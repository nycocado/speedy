[Unit]
Description=Serviço de Inicialização do Robô Speedy (ROS 2 Jazzy via Podman/Distrobox)
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory=/home/{{ ansible_user }}

# Garante que o ambiente de usuário do Podman esteja disponível
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"

# O comando entra no distrobox e executa o sistema
ExecStart=/usr/bin/distrobox-enter --name speedy-ros --no-tty -- bash -c "\
    export ROS_DOMAIN_ID=0 && \
    export RMW_IMPLEMENTATION=rmw_fastrtps_cpp && \
    source /opt/ros/jazzy/setup.bash && \
    source ~/speedy_ws/install/setup.bash && \
    ros2 launch speedy_bringup speedy.launch.py"

KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target