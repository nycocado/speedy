[connection]
id=SpeedyHotspot
uuid=1dc8d4b3-058e-4f9d-8098-fb5c9aa81deb
type=wifi
interface-name=wlan0
autoconnect=false
autoconnect-priority=100

[wifi]
mode=ap
ssid=SpeedyBot_AP
band=a
channel=36

[wifi-security]
key-mgmt=wpa-psk
psk=speedyrobot

[ipv4]
method=shared
address1=192.168.50.1/24

[ipv6]
method=ignore
