[Unit]
Description=Serviço de Inicialização do Robô Speedy (ROS 2 Jazzy Nativo)
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory=/home/{{ ansible_user }}/speedy_ws

# Tuning de Agendamento e Memória (Evitar engasgos sem forçar CPU clock)
LimitRTPRIO=99
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=85

Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"

# O comando carrega o ambiente ROS 2 do sistema e o workspace do utilizador
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /home/{{ ansible_user }}/speedy_ws/install/setup.bash && ros2 launch speedy_bringup speedy.launch.py"

KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
