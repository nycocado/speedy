[Unit]
Description=Speedy robot startup service (native ROS 2 Jazzy)
After=network-online.target multi-user.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
ExecStartPre=/bin/sleep 5
Type=simple
User=root
Group=root
WorkingDirectory=/home/{{ ansible_user }}/speedy_ws

# Memory tuning. Do NOT use a global CPUSchedulingPolicy=fifo: inherited by all
# ~14 nodes, it kills scheduler fairness under saturation (load>>4) and the
# system stutters instead of degrading gracefully. Let CFS manage scheduling;
# LimitRTPRIO stays for whichever node needs to request real-time priority.
LimitRTPRIO=99
LimitMEMLOCK=infinity

Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=file:///home/{{ ansible_user }}/speedy_ws/cyclonedds.xml"

# Sources the system ROS 2 environment and the user workspace before launching.
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /home/{{ ansible_user }}/speedy_ws/install/setup.bash && ros2 launch speedy_bringup speedy.launch.py"

KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
